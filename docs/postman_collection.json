{
  "info": {
    "name": "FIFA Players API (2015-2023)",
    "description": "Colección de endpoints para autenticación JWT y gestión de jugadores FIFA (masculinos y femeninos, ediciones 2015-2023).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Prueba\",\n  \"email\": \"prueba@fifa.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prueba@fifa.local\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "List Players (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/players?page=1&limit=10&edition=2023&gender=male",
              "host": ["{{baseUrl}}"],
              "path": ["players"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "edition", "value": "2023" },
                { "key": "gender", "value": "male" }
              ]
            }
          }
        },
        {
          "name": "Export Players CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/players/export",
              "host": ["{{baseUrl}}"],
              "path": ["players", "export"]
            }
          }
        },
        {
          "name": "Get Player By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/players/1",
              "host": ["{{baseUrl}}"],
              "path": ["players", "1"]
            }
          }
        },
        {
          "name": "Create Player",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "player-create-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lionel Messi\",\n  \"club\": \"Inter Miami\",\n  \"position\": \"RW\",\n  \"gender\": \"male\",\n  \"edition\": 2023,\n  \"pace\": 80,\n  \"shooting\": 87,\n  \"passing\": 90,\n  \"dribbling\": 94,\n  \"defending\": 34,\n  \"physical\": 64\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/players",
              "host": ["{{baseUrl}}"],
              "path": ["players"]
            }
          }
        },
        {
          "name": "Update Player (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lionel Messi\",\n  \"club\": \"FC Barcelona\",\n  \"position\": \"RW\",\n  \"gender\": \"male\",\n  \"edition\": 2023,\n  \"pace\": 81,\n  \"shooting\": 88,\n  \"passing\": 90,\n  \"dribbling\": 94,\n  \"defending\": 35,\n  \"physical\": 65\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/players/1",
              "host": ["{{baseUrl}}"],
              "path": ["players", "1"]
            }
          }
        }
      ]
    }
  ]
}